# Copy to .env.local (never committed) and fill in. On Vercel, set the same names under
# Settings → Environment Variables, then redeploy.

# Contact form → your inbox through Nodemailer (components/home/contact/send.ts).
# For Gmail, SMTP_PASS is an App Password: Google Account → Security → 2-Step Verification → App passwords.
# Without these the form opens the visitor's own mail app instead.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=

# Song search in the music island (app/api/music/search/route.ts).
# From a free app at https://developer.spotify.com/dashboard → your app → Settings.
# Without these the playlist still plays; only search is off.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
